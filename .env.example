# Firebase web configuration (public client config; Firebase rules protect data).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Production transport policy: set APP_ENV=production behind HTTPS/WSS.
APP_ENV=development
PORT=8080
MAX_ROOMS=100
ROOM_IDLE_TTL_SECONDS=300
INBOUND_QUEUE_SIZE=256
OUTBOUND_QUEUE_SIZE=512
